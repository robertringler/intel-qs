# Copy to .env and fill in. NEVER commit .env.
PP_ENV=development                     # production enforces https, secure cookies, SMTP, MFA
PP_BASE_URL=http://localhost:8000
PG_ADMIN_PASSWORD=change-me            # docker-compose only
PP_OWNER_DB_PASSWORD=change-me-owner   # used by `payeeproof provision-db`
PP_APP_DB_PASSWORD=change-me-app
PP_DATABASE_URL=postgresql+psycopg://payeeproof_app:change-me-app@db:5432/payeeproof
PP_MIGRATION_DATABASE_URL=postgresql+psycopg://payeeproof_owner:change-me-owner@db:5432/payeeproof
PP_COOKIE_SECURE=false                 # must be true behind HTTPS / in production
# Generate the four keys below with: payeeproof gen-keys
PP_FIELD_ENCRYPTION_KEYS=
PP_FINGERPRINT_KEY=
PP_NETWORK_FINGERPRINT_KEY=
PP_AUDIT_CHAIN_KEY=
PP_METRICS_TOKEN=
PP_EMAIL_BACKEND=console               # smtp in production
PP_EMAIL_FROM=PayeeProof <no-reply@example.com>
PP_SMTP_HOST=
PP_SMTP_PORT=587
PP_SMTP_USERNAME=
PP_SMTP_PASSWORD=
PP_REDIS_URL=                          # optional; enables shared rate limits across instances
PP_TRUSTED_PROXY_COUNT=0               # set to 1 behind one reverse proxy/load balancer
# Stripe (billing disabled unless both secret key and webhook secret are set)
PP_STRIPE_SECRET_KEY=
PP_STRIPE_WEBHOOK_SECRET=
PP_STRIPE_PRICE_STARTER_MONTHLY=
PP_STRIPE_PRICE_STARTER_ANNUAL=
PP_STRIPE_PRICE_GROWTH_MONTHLY=
PP_STRIPE_PRICE_GROWTH_ANNUAL=
PP_STRIPE_PRICE_SCALE_MONTHLY=
PP_STRIPE_PRICE_SCALE_ANNUAL=
PP_SENTRY_DSN=
